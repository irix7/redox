index 0000000..b9060c0
--- /dev/null
+++ b/indy/src/video.rs
@@ -0,0 +1,218 @@
+//! The Newport (XL) graphics board, driven from user mode.
+//!
+//! REX3's registers are mapped from physical 0x1F0F_0000. A frame is one
+//! block draw with host colour data: the destination rectangle, then the
+//! pixels through HOSTRW0, four 8-bit colour indices to a word, most
+//! significant byte first. A register written at its offset plus 0x800
+//! also starts the command. The engine's 320 by 200 frame is doubled to
+//! 640 by 400 and centred.
+//!
+//! The 256 colours go to the colour maps through the display control bus,
+//! one address write and one three-byte palette write per entry.
+//!
+//! Register facts: SGI's REX3 documentation as summarised in the IRIX 7
+//! project's hardware notes, and the register model of the iris emulator.
+
+use std::os::fd::AsRawFd;
+
+const REX3_PHYS: usize = 0x1f0f_0000;
+const REX3_SPAN: usize = 0x2000;
+const GO: usize = 0x0800;
+
+const DRAWMODE1: usize = 0x0000;
+const DRAWMODE0: usize = 0x0004;
+const XYSTARTI: usize = 0x0150;
+const XYENDI: usize = 0x0154;
+const WRMASK: usize = 0x0220;
+const COLORI: usize = 0x0224;
+const HOSTRW0: usize = 0x0230;
+const DCBMODE: usize = 0x0238;
+const DCBDATA0: usize = 0x0240;
+const TOPSCAN: usize = 0x1320;
+const XYWIN: usize = 0x1324;
+const CLIPMODE: usize = 0x1328;
+const STATUS: usize = 0x1338;
+
+const STATUS_GFXBUSY: u32 = 1 << 3;
+const STATUS_BACKBUSY: u32 = 1 << 4;
+
+const OP_DRAW: u32 = 2;
+const ADR_BLOCK: u32 = 1 << 2;
+const DOSETUP: u32 = 1 << 5;
+const COLORHOST: u32 = 1 << 6;
+const STOPONX: u32 = 1 << 8;
+const STOPONY: u32 = 1 << 9;
+
+// DRAWMODE1: keep the plane and depth selection the console uses, and set
+// 8-bit packed host pixels, no comparison, logic op "source".
+const DM1_PLANES_DEPTH: u32 = 0x0000_007f;
+const DM1_RWPACKED: u32 = 1 << 7;
+const DM1_HOSTDEPTH_8: u32 = 1 << 8;
+const DM1_COMPARE_OFF: u32 = 7 << 12;
+const DM1_LOGIC_SRC: u32 = 3 << 28;
+
+const CMAP_PROTOCOL: u32 = 0x0000_8000 | 0x0004_0000 | 0x0080_0000;
+const CMAP_ALL: u32 = 1 << 7;
+const CMAP_ADDRESS: u32 = 0x00;
+const CMAP_PALETTE: u32 = 0x20;
+const DCB_SWAP: u32 = 1 << 28;
+const DCB_INCREMENT: u32 = 1 << 3;
+const DCB_WIDTH_2: u32 = 2;
+const DCB_WIDTH_3: u32 = 3;
+
+const SRC_W: usize = 320;
+const SRC_H: usize = 200;
+
+pub struct Screen {
+    regs: *mut u8,
+    /// Top left corner of the doubled frame.
+    x: usize,
+    y: usize,
+    scale: usize,
+    width: usize,
+    height: usize,
+    row: Vec<u32>,
+}
+
+impl Screen {
+    pub fn open(width: usize, height: usize) -> Result<Self, String> {
+        let file = std::fs::OpenOptions::new()
+            .read(true)
+            .write(true)
+            .open("/scheme/memory/physical@dev")
+            .map_err(|err| format!("cannot open device memory (are you root?): {err}"))?;
+        let regs = unsafe {
+            libc::mmap(
+                std::ptr::null_mut(),
+                REX3_SPAN,
+                libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_SHARED,
+                file.as_raw_fd(),
+                REX3_PHYS as libc::off_t,
+            )
+        };
+        if regs == libc::MAP_FAILED {
+            return Err("cannot map the graphics board".into());
+        }
+        let scale = if width >= SRC_W * 2 && height >= SRC_H * 2 { 2 } else { 1 };
+        let screen = Self {
+            regs: regs.cast(),
+            x: (width - SRC_W * scale) / 2,
+            y: (height - SRC_H * scale) / 2,
+            scale,
+            width,
+            height,
+            row: vec![0; SRC_W * scale / 4],
+        };
+        screen.wait();
+        screen.wr(XYWIN, (4096 << 16) | 4096);
+        screen.wr(TOPSCAN, 0x3ff);
+        screen.wr(CLIPMODE, screen.rd(CLIPMODE) & !0x1f);
+        screen.wr(WRMASK, 0xffff_ffff);
+        let planes = screen.rd(DRAWMODE1) & DM1_PLANES_DEPTH;
+        screen.wr(
+            DRAWMODE1,
+            planes | DM1_RWPACKED | DM1_HOSTDEPTH_8 | DM1_COMPARE_OFF | DM1_LOGIC_SRC,
+        );
+        Ok(screen)
+    }
+
+    fn rd(&self, reg: usize) -> u32 {
+        unsafe { self.regs.add(reg).cast::<u32>().read_volatile() }
+    }
+
+    fn wr(&self, reg: usize, value: u32) {
+        unsafe { self.regs.add(reg).cast::<u32>().write_volatile(value) }
+    }
+
+    fn wait(&self) {
+        for _ in 0..2_000_000 {
+            if self.rd(STATUS) & STATUS_GFXBUSY == 0 {
+                return;
+            }
+        }
+    }
+
+    fn dcb_wait(&self) {
+        for _ in 0..200_000 {
+            if self.rd(STATUS) & STATUS_BACKBUSY == 0 {
+                return;
+            }
+        }
+    }
+
+    fn xy(x: usize, y: usize) -> u32 {
+        ((x as u32) << 16) | y as u32
+    }
+
+    pub fn clear(&self) {
+        self.wait();
+        self.wr(DRAWMODE0, OP_DRAW | ADR_BLOCK | DOSETUP | STOPONX | STOPONY);
+        self.wr(COLORI, 0);
+        self.wr(XYSTARTI, Self::xy(0, 0));
+        self.wr(GO + XYENDI, Self::xy(self.width.max(1280) - 1, self.height.max(1024) - 1));
+    }
+
+    /// Load the 256 colours, through the gamma table.
+    pub fn load_palette(&self, colours: &[[u8; 3]; 256], gamma: &[u8; 256]) {
+        for (index, [red, green, blue]) in colours.iter().enumerate() {
+            self.dcb_wait();
+            self.wr(
+                DCBMODE,
+                CMAP_ALL | CMAP_PROTOCOL | DCB_SWAP | DCB_INCREMENT | CMAP_ADDRESS | DCB_WIDTH_2,
+            );
+            unsafe {
+                self.regs
+                    .add(DCBDATA0 + 2)
+                    .cast::<u16>()
+                    .write_volatile(index as u16)
+            };
+            self.wr(DCBMODE, CMAP_ALL | CMAP_PROTOCOL | CMAP_PALETTE | DCB_WIDTH_3);
+            self.wr(
+                DCBDATA0,
+                ((gamma[*red as usize] as u32) << 24)
+                    | ((gamma[*green as usize] as u32) << 16)
+                    | ((gamma[*blue as usize] as u32) << 8),
+            );
+        }
+    }
+
+    /// Show one 320 by 200 frame of colour indices.
+    pub fn present(&mut self, frame: &[u8]) {
+        let scale = self.scale;
+        self.wait();
+        // No stop flags: the block runs on through its rows and takes
+        // four pixels from each host word as they arrive.
+        self.wr(DRAWMODE0, OP_DRAW | ADR_BLOCK | COLORHOST);
+        self.wr(XYSTARTI, Self::xy(self.x, self.y));
+        self.wr(
+            XYENDI,
+            Self::xy(self.x + SRC_W * scale - 1, self.y + SRC_H * scale - 1),
+        );
+        let hostrw = unsafe { self.regs.add(GO + HOSTRW0).cast::<u32>() };
+        for line in frame.chunks_exact(SRC_W).take(SRC_H) {
+            if scale == 2 {
+                for (word, pair) in self.row.iter_mut().zip(line.chunks_exact(2)) {
+                    let (a, b) = (pair[0] as u32, pair[1] as u32);
+                    *word = (a << 24) | (a << 16) | (b << 8) | b;
+                }
+            } else {
+                for (word, quad) in self.row.iter_mut().zip(line.chunks_exact(4)) {
+                    *word = u32::from_be_bytes([quad[0], quad[1], quad[2], quad[3]]);
+                }
+            }
+            for _ in 0..scale {
+                for &word in &self.row {
+                    unsafe { hostrw.write_volatile(word) };
+                }
+            }
+        }
+    }
+}
+
+impl Drop for Screen {
+    fn drop(&mut self) {
+        self.wait();
+        unsafe { libc::munmap(self.regs.cast(), REX3_SPAN) };
+    }
+}
