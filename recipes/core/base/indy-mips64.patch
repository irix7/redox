diff --git a/bootstrap/src/mips64.ld b/bootstrap/src/mips64.ld
new file mode 100644
index 0000000..a0201b3
--- /dev/null
+++ b/bootstrap/src/mips64.ld
@@ -0,0 +1,59 @@
+ENTRY(_start)
+OUTPUT_FORMAT(elf32-ntradbigmips)
+
+SECTIONS {
+  . = 4096 + 4096; /* Reserved for the null page and the initfs header prepended by redox-initfs-ar */
+  __initfs_header = . - 4096;
+  . += SIZEOF_HEADERS;
+  . = ALIGN(4096);
+
+  .text : {
+    __text_start = .;
+    *(.text*)
+    . = ALIGN(4096);
+    __text_end = .;
+  }
+  .rodata : {
+    __rodata_start = .;
+    *(.rodata*)
+  }
+  .data.rel.ro : {
+    *(.data.rel.ro*)
+  }
+  .got : {
+    *(.got)
+  }
+  .got.plt : {
+    *(.got.plt)
+    . = ALIGN(4096);
+    __rodata_end = .;
+  }
+  .data : {
+    __data_start = .;
+    *(.data*)
+    *(.sdata*)
+    . = ALIGN(4096);
+    __data_end = .;
+
+    __bss_start = .;
+    *(.bss*)
+    *(.sbss*)
+    *(COMMON)
+    . = ALIGN(4096);
+    __bss_end = .;
+  }
+
+  /DISCARD/ : {
+      *(.comment*)
+      *(.eh_frame*)
+      *(.gcc_except_table*)
+      *(.note*)
+      *(.rel.eh_frame*)
+      *(.MIPS.abiflags)
+      *(.MIPS.options)
+      *(.reginfo)
+      *(.pdr)
+      *(.mdebug*)
+      *(.gnu.attributes)
+  }
+}
diff --git a/bootstrap/src/mips64.rs b/bootstrap/src/mips64.rs
new file mode 100644
index 0000000..e3fd459
--- /dev/null
+++ b/bootstrap/src/mips64.rs
@@ -0,0 +1,57 @@
+//! SGI Indy: MIPS n32, 32-bit user addresses. useg ends at 0x8000_0000.
+
+use core::mem;
+
+use syscall::data::Map;
+use syscall::flag::MapFlags;
+use syscall::number::SYS_FMAP;
+
+const STACK_SIZE: usize = 64 * 1024; // 64 KiB
+pub const USERMODE_END: usize = 0x8000_0000;
+pub const STACK_START: usize = USERMODE_END - syscall::KERNEL_METADATA_SIZE - STACK_SIZE;
+
+static MAP: Map = Map {
+    offset: 0,
+    size: STACK_SIZE,
+    flags: MapFlags::PROT_READ
+        .union(MapFlags::PROT_WRITE)
+        .union(MapFlags::MAP_PRIVATE)
+        .union(MapFlags::MAP_FIXED_NOREPLACE),
+    address: STACK_START, // highest possible user address
+};
+
+core::arch::global_asm!(
+    "
+    .set noreorder
+    .globl _start
+_start:
+    # Setup a stack: SYS_FMAP(fd, &map, size). Number in $v0, result in $v0.
+    li      $2, {number}
+    li      $4, {fd}
+    la      $5, {map}
+    li      $6, {map_size}
+    syscall
+    nop
+
+    # Test for success (nonzero value).
+    bnez    $2, 2f
+    nop
+    # (failure)
+    break   0
+2:
+    li      $sp, {stack_size}
+    addu    $sp, $sp, $2
+    move    $30, $zero
+
+    jal     start
+    nop
+    # `start` must never return.
+    break   0
+    .set reorder
+    ",
+    fd = const usize::MAX, // dummy fd indicates anonymous map
+    map = sym MAP,
+    map_size = const mem::size_of::<Map>(),
+    number = const SYS_FMAP,
+    stack_size = const STACK_SIZE,
+);
