diff --git a/drivers/net/seeqd/src/device.rs b/drivers/net/seeqd/src/device.rs
new file mode 100644
index 0000000..9725c53
--- /dev/null
+++ b/drivers/net/seeqd/src/device.rs
@@ -0,0 +1,318 @@
+//! Seeq 8003 and the HPC3 Ethernet DMA engines.
+//!
+//! Register facts (checked against the iris emulator's `hpc3.rs` and
+//! `seeq8003.rs`; to be confirmed on real hardware):
+//!
+//! - HPC3 Ethernet DMA: receive engine at physical `0x1FB9_4000`, transmit at
+//!   `0x1FB9_6000`. In each: next-descriptor pointer at `+0x0004`, byte count
+//!   at `+0x1000`, control at `+0x1004`; the receive block also has the
+//!   reset register at `+0x1014`.
+//! - Seeq registers: `0x1FBD_4000`, one byte per 32-bit word. Registers 0..5
+//!   are the station address (write, bank 0), 6 is receive command/status,
+//!   7 is transmit command/status.
+//! - A descriptor is three big-endian words in a 16-byte slot: buffer
+//!   address, count and flags, next descriptor.
+//! - A received frame is written as two pad bytes, the frame, then one
+//!   status byte. HPC3 then stores the remaining count in the low half of the
+//!   count word, which clears the ownership bit.
+//! - The MAC address is in the DS1386 NVRAM, bytes 314..320, one byte per
+//!   word at `0x1FBE_0000`.
+
+use std::ptr::{read_volatile, write_volatile};
+
+use common::dma::Dma;
+use common::{MemoryType, Prot};
+use driver_network::NetworkAdapter;
+use syscall::error::{Error, Result, EIO, EMSGSIZE};
+
+pub const HPC3_ENET_PHYS: usize = 0x1FB9_4000;
+pub const SEEQ_PHYS: usize = 0x1FBD_4000;
+const NVRAM_PHYS: usize = 0x1FBE_0000;
+const NVRAM_MAC_OFFSET: usize = 314;
+
+// Offsets inside the mapped Ethernet DMA window (receive engine first).
+const RX_NDPTR: usize = 0x0004;
+const RX_CTRL: usize = 0x1004;
+const RX_RESET: usize = 0x1014;
+const TX_NDPTR: usize = 0x2004;
+const TX_CTRL: usize = 0x3004;
+
+const CTRL_ACTIVE: u32 = 0x200;
+const RESET_CHANNEL: u32 = 0x01;
+const RESET_CLEAR_IRQ: u32 = 0x02;
+
+// Seeq register numbers.
+const SEEQ_RX: usize = 6;
+const SEEQ_TX: usize = 7;
+/// Receive command: station address and broadcast, interrupt on end of frame.
+const RX_CMD: u32 = 0x80 | 0x10;
+/// Transmit command: register bank 0, interrupt on success, 16 tries,
+/// collision and underflow.
+const TX_CMD: u32 = 0x0f;
+/// Receive status byte: frame ended and was good.
+const RX_STATUS_GOOD: u8 = 0x20;
+
+// Descriptor count-word flags.
+const DESC_EOX: u32 = 0x8000_0000;
+const DESC_EOP: u32 = 0x4000_0000;
+const DESC_XIE: u32 = 0x2000_0000;
+/// Receive: the descriptor belongs to HPC3.
+const DESC_OWN: u32 = 0x0000_4000;
+/// Transmit: HPC3 has sent the packet.
+const DESC_TXD: u32 = 0x0000_8000;
+const DESC_COUNT: u32 = 0x0000_3fff;
+
+const RX_RING: usize = 16;
+const BUF_SIZE: usize = 2048;
+const MIN_FRAME: usize = 60;
+const MAX_FRAME: usize = 1514;
+
+#[repr(C, align(16))]
+#[derive(Clone, Copy)]
+struct Desc {
+    pbuf: u32,
+    cntinfo: u32,
+    pnext: u32,
+    _pad: u32,
+}
+
+pub struct Seeq {
+    enet: *mut u8,
+    seeq: *mut u8,
+    rx_ring: Dma<[Desc; RX_RING]>,
+    rx_bufs: Dma<[u8; RX_RING * BUF_SIZE]>,
+    /// Next receive descriptor to read.
+    rx_i: usize,
+    /// Descriptor that currently carries the end-of-ring mark.
+    rx_eox: usize,
+    tx_desc: Dma<[Desc; 1]>,
+    tx_buf: Dma<[u8; BUF_SIZE]>,
+    mac: [u8; 6],
+}
+
+// The device is owned by one scheme thread.
+unsafe impl Send for Seeq {}
+
+unsafe fn map(phys: usize, len: usize) -> Result<*mut u8> {
+    Ok(common::physmap(phys, len, Prot::RW, MemoryType::DeviceMemory)
+        .map_err(|_| Error::new(EIO))? as *mut u8)
+}
+
+impl Seeq {
+    unsafe fn enet_read(&self, offset: usize) -> u32 {
+        read_volatile(self.enet.add(offset) as *const u32)
+    }
+
+    unsafe fn enet_write(&self, offset: usize, value: u32) {
+        write_volatile(self.enet.add(offset) as *mut u32, value)
+    }
+
+    unsafe fn seeq_write(&self, reg: usize, value: u32) {
+        write_volatile(self.seeq.add(reg * 4) as *mut u32, value)
+    }
+
+    /// Read a volatile word of a descriptor HPC3 may be updating.
+    fn rx_cntinfo(&self, index: usize) -> u32 {
+        unsafe { read_volatile(&raw const self.rx_ring[index].cntinfo) }
+    }
+
+    fn set_rx_cntinfo(&mut self, index: usize, value: u32) {
+        unsafe { write_volatile(&raw mut self.rx_ring[index].cntinfo, value) }
+    }
+
+    pub unsafe fn new() -> Result<Self> {
+        let enet = map(HPC3_ENET_PHYS, 0x4000)?;
+        let seeq = map(SEEQ_PHYS, 0x1000)?;
+
+        // Station address from the NVRAM; a blank or erased slot gets a
+        // locally administered address.
+        let nvram = map(NVRAM_PHYS, 0x1000)?;
+        let mut mac = [0u8; 6];
+        for (i, byte) in mac.iter_mut().enumerate() {
+            *byte = read_volatile(nvram.add((NVRAM_MAC_OFFSET + i) * 4) as *const u32) as u8;
+        }
+        if mac == [0; 6] || mac == [0xff; 6] {
+            mac = [0x02, 0x11, 0x22, 0x33, 0x44, 0x55];
+        }
+
+        let map_err = |_| Error::new(EIO);
+        let mut device = Seeq {
+            enet,
+            seeq,
+            rx_ring: Dma::zeroed().map_err(map_err)?.assume_init(),
+            rx_bufs: Dma::zeroed().map_err(map_err)?.assume_init(),
+            rx_i: 0,
+            rx_eox: RX_RING - 1,
+            tx_desc: Dma::zeroed().map_err(map_err)?.assume_init(),
+            tx_buf: Dma::zeroed().map_err(map_err)?.assume_init(),
+            mac,
+        };
+        device.init();
+        Ok(device)
+    }
+
+    pub fn mac(&self) -> [u8; 6] {
+        self.mac
+    }
+
+    unsafe fn init(&mut self) {
+        // Reset both DMA channels and the Seeq, then release the reset.
+        self.enet_write(RX_RESET, RESET_CHANNEL | RESET_CLEAR_IRQ);
+        for _ in 0..1000 {
+            std::hint::spin_loop();
+        }
+        self.enet_write(RX_RESET, 0);
+
+        // Bank 0: registers 0..5 take the station address.
+        self.seeq_write(SEEQ_TX, TX_CMD);
+        for (i, byte) in self.mac.into_iter().enumerate() {
+            self.seeq_write(i, byte as u32);
+        }
+
+        // Receive ring: every descriptor owned by HPC3, the last one marked
+        // as the end of the ring, linked in a circle.
+        let ring_phys = self.rx_ring.physical() as u32;
+        let bufs_phys = self.rx_bufs.physical() as u32;
+        for i in 0..RX_RING {
+            let next = (i + 1) % RX_RING;
+            self.rx_ring[i] = Desc {
+                pbuf: bufs_phys + (i * BUF_SIZE) as u32,
+                cntinfo: DESC_OWN
+                    | DESC_XIE
+                    | BUF_SIZE as u32
+                    | if i == RX_RING - 1 { DESC_EOX } else { 0 },
+                pnext: ring_phys + (next * size_of::<Desc>()) as u32,
+                _pad: 0,
+            };
+        }
+        self.rx_i = 0;
+        self.rx_eox = RX_RING - 1;
+
+        self.seeq_write(SEEQ_RX, RX_CMD);
+        self.enet_write(RX_NDPTR, ring_phys);
+        self.enet_write(RX_CTRL, CTRL_ACTIVE);
+    }
+
+    /// Drop the interrupt the Seeq and the DMA engines raised.
+    pub fn clear_interrupt(&mut self) {
+        unsafe { self.enet_write(RX_RESET, RESET_CLEAR_IRQ) }
+    }
+
+    /// Timer tick: restart the receive channel if it stopped at the end of
+    /// the ring while descriptors are free again.
+    pub fn poll(&mut self) {
+        unsafe {
+            if self.enet_read(RX_CTRL) & CTRL_ACTIVE == 0
+                && self.rx_cntinfo(self.rx_i) & DESC_OWN != 0
+            {
+                let phys =
+                    self.rx_ring.physical() as u32 + (self.rx_i * size_of::<Desc>()) as u32;
+                self.enet_write(RX_NDPTR, phys);
+                self.enet_write(RX_CTRL, CTRL_ACTIVE);
+            }
+        }
+    }
+
+    /// Hand descriptor `index` back to HPC3 and move the end-of-ring mark onto it.
+    fn rearm(&mut self, index: usize) {
+        self.set_rx_cntinfo(index, DESC_OWN | DESC_XIE | DESC_EOX | BUF_SIZE as u32);
+        let old = self.rx_eox;
+        if old != index {
+            let value = self.rx_cntinfo(old) & !DESC_EOX;
+            self.set_rx_cntinfo(old, value);
+        }
+        self.rx_eox = index;
+    }
+}
+
+impl NetworkAdapter for Seeq {
+    fn mac_address(&mut self) -> [u8; 6] {
+        self.mac
+    }
+
+    fn available_for_read(&mut self) -> usize {
+        let mut count = 0;
+        for n in 0..RX_RING {
+            if self.rx_cntinfo((self.rx_i + n) % RX_RING) & DESC_OWN != 0 {
+                break;
+            }
+            count += 1;
+        }
+        count
+    }
+
+    fn read_packet(&mut self, buf: &mut [u8]) -> Result<Option<usize>> {
+        loop {
+            let index = self.rx_i;
+            let cntinfo = self.rx_cntinfo(index);
+            if cntinfo & DESC_OWN != 0 {
+                return Ok(None);
+            }
+
+            // Bytes HPC3 wrote: two pad bytes, the frame, one status byte.
+            let remaining = (cntinfo & DESC_COUNT) as usize;
+            let written = BUF_SIZE.saturating_sub(remaining);
+            let base = index * BUF_SIZE;
+            let result = if written >= 3 + 14 {
+                let len = written - 3;
+                let status = unsafe { read_volatile(&raw const self.rx_bufs[base + 2 + len]) };
+                if status & RX_STATUS_GOOD == 0 {
+                    None
+                } else if len > buf.len() {
+                    self.rearm(index);
+                    self.rx_i = (index + 1) % RX_RING;
+                    return Err(Error::new(EMSGSIZE));
+                } else {
+                    for (i, out) in buf[..len].iter_mut().enumerate() {
+                        *out = unsafe { read_volatile(&raw const self.rx_bufs[base + 2 + i]) };
+                    }
+                    Some(len)
+                }
+            } else {
+                None
+            };
+
+            self.rearm(index);
+            self.rx_i = (index + 1) % RX_RING;
+            self.poll();
+
+            if let Some(len) = result {
+                return Ok(Some(len));
+            }
+            // A bad or runt frame: look at the next descriptor.
+        }
+    }
+
+    fn write_packet(&mut self, buf: &[u8]) -> Result<usize> {
+        if buf.len() > MAX_FRAME {
+            return Err(Error::new(EMSGSIZE));
+        }
+        unsafe {
+            // One packet at a time: wait for the previous one to leave.
+            let mut spins = 0u32;
+            while self.enet_read(TX_CTRL) & CTRL_ACTIVE != 0 {
+                std::hint::spin_loop();
+                spins += 1;
+                if spins > 5_000_000 {
+                    return Err(Error::new(EIO));
+                }
+            }
+
+            let len = buf.len().max(MIN_FRAME);
+            for i in 0..len {
+                let byte = buf.get(i).copied().unwrap_or(0);
+                write_volatile(&raw mut self.tx_buf[i], byte);
+            }
+            self.tx_desc[0] = Desc {
+                pbuf: self.tx_buf.physical() as u32,
+                cntinfo: len as u32 | DESC_EOP | DESC_EOX | DESC_XIE,
+                pnext: 0,
+                _pad: 0,
+            };
+            let _ = DESC_TXD;
+            self.enet_write(TX_NDPTR, self.tx_desc.physical() as u32);
+            self.enet_write(TX_CTRL, CTRL_ACTIVE);
+        }
+        Ok(buf.len())
+    }
+}
diff --git a/drivers/net/seeqd/src/main.rs b/drivers/net/seeqd/src/main.rs
new file mode 100644
index 0000000..d2467b3
--- /dev/null
+++ b/drivers/net/seeqd/src/main.rs
@@ -0,0 +1,113 @@
+//! Seeq 8003 Ethernet on the SGI Indy.
+//!
+//! The controller sits behind the HPC3, which moves frames with two DMA
+//! engines walking descriptor chains in memory. The device is at fixed
+//! physical addresses; there is no bus to enumerate. Frames arrive on INT3
+//! local 0 bit 3 (`irq:3`); a slow timer restarts a stopped receive ring.
+
+use std::mem::size_of;
+
+use driver_network::NetworkScheme;
+use event::{user_data, EventQueue};
+use libredox::flag::O_RDWR;
+use libredox::Fd;
+use syscall::data::TimeSpec;
+
+pub mod device;
+
+/// Period of the fallback poll that restarts a stopped receive ring.
+const POLL_NS: i32 = 250_000_000;
+
+/// INT3 local 0 bit 3: the Seeq and its HPC3 DMA engines.
+const ETHERNET_IRQ: u32 = 3;
+
+fn arm_timer(time: &Fd) {
+    let mut now = TimeSpec::default();
+    if time.read(&mut now).map(|n| n >= size_of::<TimeSpec>()).unwrap_or(false) {
+        now.tv_nsec += POLL_NS;
+        if now.tv_nsec >= 1_000_000_000 {
+            now.tv_nsec -= 1_000_000_000;
+            now.tv_sec += 1;
+        }
+        let _ = time.write(&now);
+    }
+}
+
+fn main() {
+    daemon::Daemon::new(daemon);
+}
+
+fn daemon(daemon: daemon::Daemon) -> ! {
+    common::init();
+
+    let device = unsafe { device::Seeq::new().expect("seeqd: failed to set up the device") };
+    let mac = device.mac();
+    println!(
+        "seeqd: Seeq 8003 at {:#x}, MAC {:02x}:{:02x}:{:02x}:{:02x}:{:02x}:{:02x}",
+        device::SEEQ_PHYS,
+        mac[0],
+        mac[1],
+        mac[2],
+        mac[3],
+        mac[4],
+        mac[5]
+    );
+
+    let mut scheme = NetworkScheme::new(move || device, daemon, "network.seeq".to_string());
+
+    user_data! {
+        enum Source {
+            Irq,
+            Time,
+            Scheme,
+        }
+    }
+
+    let irq = Fd::open(&format!("/scheme/irq/{ETHERNET_IRQ}"), O_RDWR, 0)
+        .expect("seeqd: failed to open the Ethernet interrupt");
+
+    let time_path = format!("/scheme/time/{}", syscall::CLOCK_MONOTONIC);
+    let time = Fd::open(&time_path, O_RDWR, 0).expect("seeqd: failed to open the time scheme");
+
+    let event_queue = EventQueue::<Source>::new().expect("seeqd: could not create event queue");
+    event_queue
+        .subscribe(irq.raw(), Source::Irq, event::EventFlags::READ)
+        .expect("seeqd: failed to subscribe to the interrupt");
+    event_queue
+        .subscribe(time.raw(), Source::Time, event::EventFlags::READ)
+        .expect("seeqd: failed to subscribe to the timer");
+    event_queue
+        .subscribe(
+            scheme.event_handle().raw(),
+            Source::Scheme,
+            event::EventFlags::READ,
+        )
+        .expect("seeqd: failed to subscribe to the scheme");
+
+    arm_timer(&time);
+    scheme.tick().unwrap();
+
+    for event in event_queue.map(|e| e.expect("seeqd: failed to get next event")) {
+        match event.user_data {
+            Source::Irq => {
+                // The kernel masked the line; clear the cause, serve the
+                // rings, then acknowledge to unmask it.
+                let mut count = [0u8; 8];
+                let len = irq.read(&mut count).unwrap_or(0);
+                scheme.adapter_mut().clear_interrupt();
+                scheme.adapter_mut().poll();
+                scheme.tick().unwrap();
+                let _ = irq.write(&count[..len]);
+            }
+            Source::Time => {
+                scheme.adapter_mut().poll();
+                scheme.tick().unwrap();
+                arm_timer(&time);
+            }
+            Source::Scheme => {
+                scheme.tick().unwrap();
+            }
+        }
+    }
+    unreachable!()
+}
