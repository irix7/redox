diff --git a/bootstrap/src/initfs.rs b/bootstrap/src/initfs.rs
index 45528dc..bcc7aad 100644
--- a/bootstrap/src/initfs.rs
+++ b/bootstrap/src/initfs.rs
@@ -46,6 +46,9 @@ pub struct InitFsScheme {
     handles: HashMap<usize, Handle, BuildHasherDefault<SipHasher>>,
     next_id: usize,
     fs: InitFs<'static>,
+    /// The archive's pages were returned to the kernel (`unlinkat` of
+    /// `image`): `fs` points at unmapped memory and no request may reach it.
+    dropped: bool,
 }
 impl InitFsScheme {
     pub fn new(bytes: &'static [u8]) -> Self {
@@ -54,6 +57,7 @@ impl InitFsScheme {
             next_id: 0,
             fs: InitFs::new(bytes, Some(PAGE_SIZE.try_into().unwrap()))
                 .expect("failed to parse initfs"),
+            dropped: false,
         }
     }
 
@@ -329,6 +333,49 @@ impl SchemeSync for InitFsScheme {
         Ok(())
     }
 
+    /// `unlinkat` of `image` gives the whole archive back to the kernel.
+    ///
+    /// The archive is resident memory, and on a 32 MiB machine it is larger
+    /// than anything else. Once the root filesystem is mounted and the
+    /// programs of the initfs are running, nothing reads it again. After
+    /// this call every request fails with ENOENT.
+    fn unlinkat(&mut self, fd: usize, path: &str, _flags: usize, ctx: &CallerCtx) -> Result<()> {
+        if !matches!(
+            self.handles.get(&fd).ok_or(Error::new(EBADF))?,
+            Handle::SchemeRoot
+        ) {
+            return Err(Error::new(EACCES));
+        }
+        if path.trim_matches('/') != "image" {
+            return Err(Error::new(ENOENT));
+        }
+        if ctx.uid != 0 {
+            return Err(Error::new(EPERM));
+        }
+        unsafe extern "C" {
+            static __initfs_header: u8;
+            static __bss_end: u8;
+        }
+        // The same range bootstrap unmaps in its own address space after
+        // it has forked this daemon.
+        unsafe {
