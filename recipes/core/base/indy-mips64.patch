+//! SGI Indy: MIPS n32, 32-bit user addresses. useg ends at 0x8000_0000.
+
+use core::mem;
+
+use syscall::data::Map;
+use syscall::flag::MapFlags;
+use syscall::number::SYS_FMAP;
+
+const STACK_SIZE: usize = 64 * 1024; // 64 KiB
+// 64 KiB below the end of useg: see the kernel's USER_END_OFFSET.
+pub const USERMODE_END: usize = 0x7fff_0000;
+pub const STACK_START: usize = USERMODE_END - syscall::KERNEL_METADATA_SIZE - STACK_SIZE;
+
+static MAP: Map = Map {
+    offset: 0,
+    size: STACK_SIZE,
+    flags: MapFlags::PROT_READ
+        .union(MapFlags::PROT_WRITE)
+        .union(MapFlags::MAP_PRIVATE)
+        .union(MapFlags::MAP_FIXED_NOREPLACE),
+    address: STACK_START, // highest possible user address
+};
+
+core::arch::global_asm!(
+    "
+    .set noreorder
+    .globl _start
+_start:
+    # Setup a stack: SYS_FMAP(fd, &map, size). Number in $v0, result in $v0.
+    li      $2, {number}
+    li      $4, {fd}
+    la      $5, {map}
+    li      $6, {map_size}
+    syscall
+    nop
+
+    # Test for success (nonzero value).
+    bnez    $2, 2f
+    nop
+    # (failure)
+    break   0
+2:
+    li      $sp, {stack_size}
+    addu    $sp, $sp, $2
+    move    $30, $zero
+
+    jal     start
+    nop
+    # `start` must never return.
+    break   0
+    .set reorder
+    ",
+    fd = const usize::MAX, // dummy fd indicates anonymous map
+    map = sym MAP,
+    map_size = const mem::size_of::<Map>(),
+    number = const SYS_FMAP,
+    stack_size = const STACK_SIZE,
+);
