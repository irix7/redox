 bootstrap/src/mips64.rs | 57 +++++++++++++++++++++++++++++++++++++++
 5 files changed, 128 insertions(+), 9 deletions(-)
 create mode 100644 bootstrap/src/mips64.ld
 create mode 100644 bootstrap/src/mips64.rs

