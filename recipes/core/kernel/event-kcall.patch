From beab6bf16dd6a4e65b6e5c002dc23f6222a4ab8f Mon Sep 17 00:00:00 2001
From: Wildan M <willnode@wellosoft.net>
Date: Sun, 8 Nov 2026 00:29:26 +0700
Subject: [PATCH 1/2] Implement event kcall for posix poll

---
 src/scheme/event.rs | 85 ++++++++++++++++++++++++++++++++++++++++++++-
 syscall/src/flag.rs |  1 +
 2 files changed, 85 insertions(+), 1 deletion(-)

diff --git a/src/scheme/event.rs b/src/scheme/event.rs
index 53ca8b99..56f6ea30 100644
--- a/src/scheme/event.rs
+++ b/src/scheme/event.rs
@@ -8,7 +8,7 @@ use crate::{
     syscall::{
         data::Event,
         error::*,
-        usercopy::{UserSliceRo, UserSliceWo},
+        usercopy::{UserSliceRo, UserSliceRw, UserSliceWo},
     },
 };
 
@@ -40,6 +40,89 @@ impl KernelScheme for EventScheme {
         Ok(OpenResult::SchemeLocal(id.get(), InternalFlags::empty()))
     }
 
+    fn kcall(
+        &self,
+        fds: &[usize],
+        payload: UserSliceRw,
+        _flags: syscall::CallFlags,
+        metadata: &[u64],
+        token: &mut CleanLockToken,
+    ) -> Result<usize> {
+        if fds.len() != 1 {
+            return Err(Error::new(EINVAL));
+        }
+
+        let id = EventQueueId::from(fds[0]);
+        let queue = {
+            let handles = queues(token.token());
+            let handle = handles.get(&id).ok_or(Error::new(EBADF))?;
+            handle.clone()
+        };
+
+        // metadata[0] = RSVDZ
+        // metadata[1] = event length in bytes
+        // metadata[2] = read flags
+        let write_len = metadata.get(1).copied().unwrap_or(0) as usize;
+        let read_flags = metadata.get(2).copied().unwrap_or(0) as usize;
+
+        if write_len > payload.len() {
+            return Err(Error::new(EINVAL));
+        }
+
+        let (input_slice, output_slice) = payload.split_at(write_len).ok_or(Error::new(EINVAL))?;
+
+        let mut nval_count = 0;
+        let mut output_remain = output_slice.into_wo()?;
+
+        if write_len > 0 {
+            for chunk in input_slice.in_exact_chunks(size_of::<Event>()) {
+                let event = unsafe { chunk.read_exact::<Event>()? };
+
+                match queue.write(&[event], token) {
+                    Ok(_) => {}
+                    Err(e) if e.errno == EBADF => {
+                        let nval_event = Event {
+                            id: event.id,
+                            flags: EventFlags::EVENT_NVAL,
+                            data: event.data,
+                        };
+
+                        let chunk_wo = output_remain
+                            .limit(size_of::<Event>())
+                            .ok_or(Error::new(EINVAL))?;
+                        unsafe { chunk_wo.copy_from_slice(&nval_event)? };
+
+                        output_remain = output_remain
+                            .advance(size_of::<Event>())
+                            .ok_or(Error::new(EINVAL))?;
+                        nval_count += 1;
+                    }
+                    Err(e) => return Err(e),
+                }
+            }
+        }
+
+        // nval must be reported immediately
+        let block = read_flags & O_NONBLOCK == 0 && nval_count == 0;
+
+        let bytes_read = match queue.read(output_remain, block, token) {
+            Ok(bytes) => bytes,
+            Err(Error { errno: EAGAIN }) => return Ok(nval_count * size_of::<Event>()),
+            Err(e) => return Err(e),
+        };
+        let total_bytes_out = (nval_count * size_of::<Event>()) + bytes_read;
+
+        if write_len > 0 {
+            for chunk in input_slice.in_exact_chunks(size_of::<Event>()) {
+                if let Ok(mut event) = unsafe { chunk.read_exact::<Event>() } {
+                    event.flags = EventFlags::empty();
+                    let _ = queue.write(&[event], token);
+                }
+            }
+        }
+        Ok(total_bytes_out)
+    }
+
     fn close(&self, id: usize, token: &mut CleanLockToken) -> Result<()> {
         let id = EventQueueId::from(id);
         unregister_queue(id, token);
diff --git a/syscall/src/flag.rs b/syscall/src/flag.rs
index 1005201e..f3445062 100644
--- a/syscall/src/flag.rs
+++ b/syscall/src/flag.rs
@@ -49,6 +49,7 @@ bitflags! {
         const EVENT_WRITE = 2;
         const EVENT_HUP = 4;
         const EVENT_ERR = 8;
+        const EVENT_NVAL = 16;
     }
 }
 
-- 
