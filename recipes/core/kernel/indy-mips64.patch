+pub mod cpu;
+pub mod serial;
+
+pub unsafe fn init() {
+    unsafe {
+        super::time::init();
+        super::interrupt::irq::init();
+    }
+}
+
+pub unsafe fn init_noncore() {}
+
+pub struct ArchPercpuMisc;
+
+impl ArchPercpuMisc {
+    pub const fn default() -> Self {
+        Self
+    }
+}
