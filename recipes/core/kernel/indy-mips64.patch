+//! Indy devices the kernel itself drives: the serial console and the CP0
+//! timer. Everything else (HPC3, SCSI, Seeq Ethernet, Newport) is a userspace
+//! scheme reached through fixed kseg1 addresses; there is no bus enumeration.
+
+pub mod arcs;
+pub mod cpu;
+pub mod serial;
+
+pub unsafe fn init() {
+    unsafe {
+        super::time::init();
+        super::interrupt::irq::init();
+    }
+}
+
+pub unsafe fn init_noncore() {}
+
+pub struct ArchPercpuMisc;
+
+impl ArchPercpuMisc {
+    pub const fn default() -> Self {
+        Self
+    }
+}
