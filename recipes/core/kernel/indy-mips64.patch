--- a/src/main.rs
+++ b/src/main.rs
@@ -4,6 +4,7 @@
 //! provides Unix-like syscalls for primarily Rust applications
 
 #![feature(int_roundings)]
+#![cfg_attr(target_arch = "mips64", feature(asm_experimental_arch))]
