diff --git a/src/arch/mips64/cache.rs b/src/arch/mips64/cache.rs
new file mode 100644
index 00000000..cb70e2ca
--- /dev/null
+++ b/src/arch/mips64/cache.rs
@@ -0,0 +1,93 @@
+//! Primary cache flushing.
+//!
+//! The R4x00 and R5000 primary caches are indexed by virtual address and are
+//! larger per way than a 4 KiB page, so one frame reached through two
+//! addresses of different colour (kseg0 and a user mapping, or two user
+//! mappings) has two independent cached copies. The instruction cache also
+//! fills from RAM and does not see data still held in the data cache. Only
+//! an R4000/R4400 with a secondary cache traps on this (VCED/VCEI).
+//!
+//! The kernel keeps the copies apart in time. The data cache is written
+//! back and emptied when a trap from user mode is about to touch frames,
+//! and both caches are emptied before the return to user mode. User code
+//! therefore starts on RAM that is current, and the kernel reads frames the
+//! user's cached lines have already reached. A refill served from the page
+//! table touches no frame and skips both.
+//!
+//! This costs every trap two passes over the caches. It is the first
+//! correct version; tracking which frames are cached under which colour is
+//! the cheaper design to move to.
+
+use core::sync::atomic::{AtomicUsize, Ordering};
+
+use super::cp0;
+
+static DCACHE_BYTES: AtomicUsize = AtomicUsize::new(0);
+static DCACHE_LINE: AtomicUsize = AtomicUsize::new(16);
+static ICACHE_BYTES: AtomicUsize = AtomicUsize::new(0);
+static ICACHE_LINE: AtomicUsize = AtomicUsize::new(16);
+
+/// Index operations select the line (and the way, with the top index bit)
+/// from the address, so any kseg0 range of the cache's size reaches it all.
+const BASE: usize = 0x8000_0000;
+
+/// Read the primary cache geometry from Config: IC bits 11..9 and DC bits
+/// 8..6 give 4 KiB << n, IB bit 5 and DB bit 4 give 16- or 32-byte lines.
+pub fn init() {
+    let config = cp0::read_config();
+    let icache = 4096usize << ((config >> 9) & 7);
+    let dcache = 4096usize << ((config >> 6) & 7);
+    let iline = if config & (1 << 5) != 0 { 32 } else { 16 };
+    let dline = if config & (1 << 4) != 0 { 32 } else { 16 };
+    ICACHE_BYTES.store(icache, Ordering::Relaxed);
+    ICACHE_LINE.store(iline, Ordering::Relaxed);
+    DCACHE_BYTES.store(dcache, Ordering::Relaxed);
+    DCACHE_LINE.store(dline, Ordering::Relaxed);
+    info!(
+        "Indy: primary caches I {} KiB/{} B lines, D {} KiB/{} B lines",
+        icache >> 10,
+        iline,
+        dcache >> 10,
+        dline
+    );
+}
+
+/// Write back and invalidate every data cache line.
+pub fn flush_data() {
+    let line = DCACHE_LINE.load(Ordering::Relaxed);
+    let end = BASE + DCACHE_BYTES.load(Ordering::Relaxed);
+    let mut addr = BASE;
+    while addr < end {
+        unsafe {
+            core::arch::asm!(
+                "cache 1, 0({0})", // Index_Writeback_Inv_D
+                in(reg) addr,
+                options(nostack)
+            );
+        }
+        addr += line;
+    }
+}
+
+/// Invalidate every instruction cache line.
+pub fn flush_instructions() {
+    let line = ICACHE_LINE.load(Ordering::Relaxed);
+    let end = BASE + ICACHE_BYTES.load(Ordering::Relaxed);
+    let mut addr = BASE;
+    while addr < end {
+        unsafe {
+            core::arch::asm!(
+                "cache 0, 0({0})", // Index_Invalidate_I
+                in(reg) addr,
+                options(nostack)
+            );
+        }
+        addr += line;
+    }
+}
+
+/// Both caches, before user code runs.
+pub extern "C" fn flush_for_user() {
+    flush_data();
+    flush_instructions();
+}
diff --git a/src/arch/mips64/consts.rs b/src/arch/mips64/consts.rs
new file mode 100644
index 00000000..947305d1
--- /dev/null
+++ b/src/arch/mips64/consts.rs
@@ -0,0 +1,24 @@
+//! Fixed virtual addresses. Physical RAM starts at 0x0800_0000 and is reached
+//! through kseg0 (`PHYS_OFFSET` 0x8000_0000) and kseg1 for devices.
+
+/// Offset to kernel heap: the start of kseg2, TLB mapped. The heap is a fixed
+/// 1 MiB (`allocator::KERNEL_HEAP_SIZE`).
+#[inline(always)]
+pub fn kernel_heap_offset() -> usize {
+    0xC000_0000
+}
+
+/// End of user mappings, 64 KiB below the end of useg. The thread pointer is
+/// the TLS block plus 0x7000 and is used with negative offsets; with
+/// Status.UX set the CPU adds base and offset in 64 bits, so a thread
+/// pointer at or above 0x8000_0000 (sign-extended in its register) gives an
+/// address error. Nothing may be mapped where that sum could cross.
+pub const USER_END_OFFSET: usize = 0x7fff_0000;
+
+/// Physical base of DRAM on the Indy.
+pub const RAM_PHYS_BASE: usize = 0x0800_0000;
+
+/// Physical bytes below the kernel reserved for the PROM, the exception
+/// vectors (the first 512 KiB of RAM is aliased at physical 0) and the ARCS
+/// parameter block.
+pub const LOW_RESERVED_BYTES: usize = 0x0004_0000;
diff --git a/src/arch/mips64/cp0.rs b/src/arch/mips64/cp0.rs
new file mode 100644
index 00000000..fe08c5ca
--- /dev/null
+++ b/src/arch/mips64/cp0.rs
@@ -0,0 +1,112 @@
+//! CP0 (system control coprocessor) registers of the R4400.
+
+use core::arch::asm;
+
+pub const INDEX: u32 = 0;
+pub const ENTRY_LO0: u32 = 2;
+pub const ENTRY_LO1: u32 = 3;
+pub const CONTEXT: u32 = 4;
+pub const PAGE_MASK: u32 = 5;
+pub const WIRED: u32 = 6;
+pub const BAD_VADDR: u32 = 8;
+pub const COUNT: u32 = 9;
+pub const ENTRY_HI: u32 = 10;
+pub const COMPARE: u32 = 11;
+pub const STATUS: u32 = 12;
+pub const CAUSE: u32 = 13;
+pub const EPC: u32 = 14;
+pub const PRID: u32 = 15;
+pub const CONFIG: u32 = 16;
+
+/// Status register bits.
+pub mod status {
+    pub const IE: u32 = 1 << 0;
+    pub const EXL: u32 = 1 << 1;
+    pub const ERL: u32 = 1 << 2;
+    /// Kernel/supervisor/user mode field: 0 kernel, 2 user.
+    pub const KSU_MASK: u32 = 0x18;
+    pub const KSU_USER: u32 = 0x10;
+    pub const UX: u32 = 1 << 5;
+    pub const SX: u32 = 1 << 6;
+    pub const KX: u32 = 1 << 7;
+    pub const IM_MASK: u32 = 0xff00;
+    /// INT3 local 0 (IP2) and local 1 (IP3).
+    pub const IM2: u32 = 1 << 10;
+    pub const IM3: u32 = 1 << 11;
+    /// Timer interrupt (IP7).
+    pub const IM7: u32 = 1 << 15;
+    /// Interrupt inputs every context runs with: timer and both INT3 cascades.
+    pub const IM_ENABLED: u32 = IM7 | IM2 | IM3;
+    /// Bootstrap exception vectors (PROM) when set.
+    pub const BEV: u32 = 1 << 22;
+    pub const CU1: u32 = 1 << 29;
+}
+
+/// Cause register bits.
+pub mod cause {
+    pub const EXC_CODE_MASK: u32 = 0x7c;
+    pub const EXC_CODE_SHIFT: u32 = 2;
+    pub const IP_MASK: u32 = 0xff00;
+    pub const IP2: u32 = 1 << 10;
+    pub const IP3: u32 = 1 << 11;
+    pub const IP7: u32 = 1 << 15;
+    /// Exception in a branch delay slot.
+    pub const BD: u32 = 1 << 31;
+
+    pub const EXC_INT: u32 = 0;
+    pub const EXC_MOD: u32 = 1;
+    pub const EXC_TLBL: u32 = 2;
+    pub const EXC_TLBS: u32 = 3;
+    pub const EXC_ADEL: u32 = 4;
+    pub const EXC_ADES: u32 = 5;
+    pub const EXC_IBE: u32 = 6;
+    pub const EXC_DBE: u32 = 7;
+    pub const EXC_SYS: u32 = 8;
+    pub const EXC_BP: u32 = 9;
+    pub const EXC_RI: u32 = 10;
+    pub const EXC_CPU: u32 = 11;
+    pub const EXC_OV: u32 = 12;
+    pub const EXC_TR: u32 = 13;
+    pub const EXC_FPE: u32 = 15;
+}
+
+macro_rules! cp0_access {
+    ($read:ident, $write:ident, $reg:expr) => {
+        #[inline(always)]
+        pub fn $read() -> u32 {
+            let value: u32;
+            unsafe {
+                asm!(concat!("mfc0 {}, $", $reg), out(reg) value, options(nomem, nostack));
+            }
+            value
+        }
+
+        /// # Safety
+        /// Writing CP0 changes CPU state: translation, interrupts or timing.
+        #[inline(always)]
+        pub unsafe fn $write(value: u32) {
+            unsafe {
+                asm!(
+                    concat!("mtc0 {}, $", $reg),
+                    "nop",
+                    "nop",
+                    in(reg) value,
+                    options(nomem, nostack)
+                );
+            }
+        }
+    };
+}
+
+cp0_access!(read_status, write_status, 12);
+cp0_access!(read_cause, write_cause, 13);
+cp0_access!(read_epc, write_epc, 14);
+cp0_access!(read_count, write_count, 9);
+cp0_access!(read_compare, write_compare, 11);
+cp0_access!(read_bad_vaddr, write_bad_vaddr, 8);
+cp0_access!(read_prid, write_prid, 15);
+cp0_access!(read_config, write_config, 16);
+cp0_access!(read_entry_hi, write_entry_hi, 10);
+cp0_access!(read_wired, write_wired, 6);
+cp0_access!(read_page_mask, write_page_mask, 5);
+cp0_access!(read_context, write_context, 4);
