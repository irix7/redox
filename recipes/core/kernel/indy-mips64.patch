diff --git a/src/arch/mips64/misc.rs b/src/arch/mips64/misc.rs
new file mode 100644
index 00000000..cff02765
--- /dev/null
+++ b/src/arch/mips64/misc.rs
@@ -0,0 +1,60 @@
+//! Per-CPU block. The R4400 has no thread-pointer register in kernel mode and
+//! the Indy has one CPU, so the block is reached through a static pointer the
+//! exception entry also reads.
+
+use core::cell::SyncUnsafeCell;
+
+use crate::{
+    cpu_set::LogicalCpuId,
+    memory::{RmmA, RmmArch},
+    percpu::PercpuBlock,
+};
+
+#[repr(C)]
+pub struct ArchPercpu {
+    // These fields must be kept first and in this order. Assembly in exception.rs depends on it.
+    pub tmp: usize,
+    /// Kernel stack pointer to load when an exception arrives from user mode:
+    /// the top of the current context's kernel stack.
+    pub kernel_sp: usize,
+
+    pub percpu: PercpuBlock,
+}
+
+/// Address of the single `ArchPercpu`; 0 until `init`.
+#[unsafe(no_mangle)]
+pub static PERCPU_PTR: SyncUnsafeCell<usize> = SyncUnsafeCell::new(0);
+
+pub fn arch_percpu() -> *mut ArchPercpu {
+    unsafe { PERCPU_PTR.get().read_volatile() as *mut ArchPercpu }
+}
+
+#[cfg(not(test))]
+impl PercpuBlock {
+    pub fn current() -> &'static Self {
+        let ptr = arch_percpu();
+        assert!(!ptr.is_null(), "percpu used before misc::init");
+        unsafe { &(*ptr).percpu }
+    }
+}
+
+#[cold]
+pub unsafe fn init(cpu_id: LogicalCpuId) {
+    unsafe {
+        const {
+            assert!(size_of::<ArchPercpu>() <= crate::memory::PAGE_SIZE);
+        }
+        let must_be_zero = true;
+        let frame =
+            crate::memory::allocate_frame(must_be_zero).expect("failed to allocate percpu memory");
+        let virt = RmmA::phys_to_virt(frame.base()).data() as *mut ArchPercpu;
+
+        virt.write(ArchPercpu {
+            tmp: 0,
+            kernel_sp: 0,
+            percpu: PercpuBlock::init(cpu_id),
+        });
+
+        PERCPU_PTR.get().write_volatile(virt as usize);
+    }
+}
diff --git a/src/arch/mips64/mod.rs b/src/arch/mips64/mod.rs
new file mode 100644
index 00000000..7b971873
--- /dev/null
+++ b/src/arch/mips64/mod.rs
@@ -0,0 +1,92 @@
+//! SGI Indy (IP24): MIPS R4400, n32 kernel with 32-bit addresses, big-endian.
+//!
+//! Address space: useg (0..0x8000_0000) is user and TLB mapped; kseg0
+//! (0x8000_0000) is the cached direct map the kernel runs in; kseg1
+//! (0xA000_0000) is the uncached direct map used for device registers; kseg2
+//! (0xC000_0000) holds TLB-mapped kernel memory: the heap and kernel stacks.
+
+/// Constants like memory locations
+pub mod consts;
+
+/// CP0 register access
+pub mod cache;
+pub mod cp0;
+
+/// Debugging support
+pub mod debug;
+
+/// Devices
+pub mod device;
+
+/// Interrupt instructions
+#[macro_use]
+pub mod interrupt;
+
+/// Inter-processor interrupts (one CPU: no-ops)
+pub mod ipi;
+
+/// Per-CPU data
+pub mod misc;
+
+/// Paging
+pub mod paging;
+
+/// Initialization and start function
+pub mod start;
+
+/// Stop function
+pub mod stop;
+
+pub mod time;
+
+pub use ::rmm::mips::MipsArch as CurrentRmmArch;
+use core::arch::naked_asm;
+
+pub use arch_copy_to_user as arch_copy_from_user;
+
+/// Copy `len` bytes from `src` to `dst`, one of them in userspace. A fault
+/// inside `__usercopy_start..__usercopy_end` is turned into a non-zero
+/// return by the page fault handler (`recover_and_efault`).
+#[unsafe(naked)]
+pub unsafe extern "C" fn arch_copy_to_user(dst: usize, src: usize, len: usize) -> u8 {
+    naked_asm!(
+        "
+        .set noreorder
+    .global __usercopy_start
+    __usercopy_start:
+        beqz    $6, 2f
+        nop
+    1:  lbu     $8, 0($5)
+        addiu   $5, $5, 1
+        addiu   $6, $6, -1
+        sb      $8, 0($4)
+        bnez    $6, 1b
+        addiu   $4, $4, 1
+    2:  jr      $31
+        move    $2, $zero
+    .global __usercopy_end
+    __usercopy_end:
+        .set reorder
+    "
+    )
+}
+
+pub const KFX_SIZE: usize = 512;
+
+// This function exists as the KFX size is dynamic on x86_64.
+pub fn kfx_size() -> usize {
+    KFX_SIZE
+}
+
+#[inline]
+pub fn current_stack_ptr() -> *mut u8 {
+    let ret: *mut u8;
+    unsafe {
+        core::arch::asm!(
+            "move {}, $sp",
+            out(reg) ret,
+            options(nomem, preserves_flags, nostack),
+        );
+    }
+    ret
+}
diff --git a/src/arch/mips64/paging.rs b/src/arch/mips64/paging.rs
new file mode 100644
index 00000000..599f5488
--- /dev/null
+++ b/src/arch/mips64/paging.rs
@@ -0,0 +1,26 @@
+//! TLB setup: 4 KiB pages, nothing wired, ASID 0, every entry cleared, and
+//! the exception vectors in place so refills can be served.
+
+use super::cp0;
+
+#[cold]
+pub unsafe fn init() {
+    unsafe {
+        // Each step reports while the PROM's vectors are still in charge, so
+        // a hang on real hardware names the step it happened in.
+        info!(
+            "Indy: PRId {:#x}, Config {:#x}, Status {:#x}",
+            cp0::read_prid(),
+            cp0::read_config(),
+            cp0::read_status()
+        );
+        super::cache::init();
+        cp0::write_entry_hi(0); // ASID 0
+        rmm::mips::flush_all();
+        info!("Indy: TLB cleared");
+        super::interrupt::exception::install_vectors();
+        info!("Indy: vectors written");
+        // Vectors live in kseg0 now: leave the PROM's bootstrap vectors.
+        cp0::write_status(cp0::read_status() & !cp0::status::BEV);
+    }
+}
diff --git a/src/arch/mips64/start.rs b/src/arch/mips64/start.rs
new file mode 100644
index 00000000..dd570a1d
--- /dev/null
+++ b/src/arch/mips64/start.rs
@@ -0,0 +1,321 @@
+//! Kernel entry from the SGI PROM.
+//!
+//! `boot -f bootp()redox` loads the ECOFF image at kseg0 0x8804_0000 and
+//! jumps to `kstart` with ARCS arguments in `$a0`..`$a2`, caches on, TLB
+//! unused by us, interrupts off and `Status.BEV` set. There is no bootloader
+//! and no `KernelArgs`, so `kstart` builds them: the kernel's own extent from
+//! linker symbols, one memory area sized from the memory controller, an empty
+//! environment and no bootstrap image yet.
+
+use core::{arch::naked_asm, cell::SyncUnsafeCell};
+
+use crate::{
+    allocator,
+    arch::{consts, cp0, device, paging},
+    context::context::Kstack,
+    devices::graphical_debug,
+    startup::{memory::BootloaderMemoryKind, KernelArgs},
+};
+
+#[repr(C, align(16))]
+struct StackAlign<T>(T);
+
+/// Boot stack, page aligned so it can be registered with the memory map.
+#[repr(C, align(4096))]
+struct PageAlign<T>(T);
+
+const STACK_SIZE: usize = 64 * 1024;
+static STACK: SyncUnsafeCell<PageAlign<[u8; STACK_SIZE]>> =
+    SyncUnsafeCell::new(PageAlign([0; STACK_SIZE]));
+
+/// Matches `BootloaderMemoryEntry` in startup::memory.
+#[repr(C, packed(8))]
+struct AreaEntry {
+    base: u64,
+    size: u64,
+    kind: BootloaderMemoryKind,
+}
+
+/// The environment handed to userspace through `sys:env`.
+static ENV: &[u8] = b"BOOTSTRAP_LOG_LEVEL=info\n";
+
+const MAX_AREAS: usize = 16;
+
+static AREAS: SyncUnsafeCell<[AreaEntry; MAX_AREAS]> = SyncUnsafeCell::new(
+    [const {
+        AreaEntry {
+            base: 0,
+            size: 0,
+            kind: BootloaderMemoryKind::Null,
+        }
+    }; MAX_AREAS],
+);
+
+unsafe extern "C" {
+    static __bss_start: u8;
+    static __bss_end: u8;
+    static __end: u8;
+}
+
+// FIXME use extern "custom"
+#[unsafe(naked)]
+#[unsafe(no_mangle)]
+#[unsafe(link_section = ".text.kstart")]
+extern "C" fn kstart() {
+    naked_asm!(
+        "
+        .set noreorder
+        .set noat
+        // Kernel mode, interrupts off, 32-bit addressing, keep BEV until the
+        // vectors are installed.
+        li      $8, {status}
+        mtc0    $8, $12
+        nop
+        nop
+        move    $28, $zero
+
+        la      $sp, {stack}
+        li      $8, {stack_size}
+        addu    $sp, $sp, $8
+        addiu   $sp, $sp, -16
+
+        la      $8, __bss_start
+        la      $9, __bss_end
+    1:
+        sltu    $10, $8, $9
+        beqz    $10, 2f
+        nop
+        sw      $zero, 0($8)
+        b       1b
+        addiu   $8, $8, 4
+    2:
+        la      $25, {start}
+        jalr    $25
+        nop
+    3:
+        b       3b
+        nop
+        .set at
+        .set reorder
+        ",
+        status = const cp0::status::BEV,
+        stack = sym STACK,
+        stack_size = const STACK_SIZE,
+        start = sym start,
+    );
+}
+
+/// Bytes of DRAM the PROM mapped contiguously from `RAM_PHYS_BASE`.
+///
+/// `MEMCFG0`/`MEMCFG1` each hold two 16-bit bank fields: bit 13 valid, bits
+/// 12..8 size in units minus one, bits 7..0 base in units. The unit is 4 MiB
+/// below memory controller revision 5 and 16 MiB from revision 5.
+fn ram_bytes() -> usize {
+    const MC_SYSID: *const u32 = 0xBFA0_001C as *const u32;
+    const MC_MEMCFG0: *const u32 = 0xBFA0_00C4 as *const u32;
+    const MC_MEMCFG1: *const u32 = 0xBFA0_00CC as *const u32;
+    let (sysid, cfg0, cfg1) = unsafe {
+        (
+            MC_SYSID.read_volatile(),
+            MC_MEMCFG0.read_volatile(),
+            MC_MEMCFG1.read_volatile(),
+        )
+    };
+    let shift = if sysid & 0x0f >= 5 { 24 } else { 22 };
+    let mut end = consts::RAM_PHYS_BASE as u64;
+    let fields = [cfg0 >> 16, cfg0 & 0xffff, cfg1 >> 16, cfg1 & 0xffff];
+    for _ in 0..fields.len() {
+        for field in fields {
+            if field & 0x2000 == 0 {
+                continue;
+            }
+            let base = ((field & 0xff) as u64) << shift;
+            let size = ((((field >> 8) & 0x1f) + 1) as u64) << shift;
+            if base <= end && base + size > end {
+                end = base + size;
+            }
+        }
+    }
+    (end - consts::RAM_PHYS_BASE as u64) as usize
+}
+
+/// The entry to Rust, all things must be initialized
+unsafe extern "C" fn start() -> ! {
+    unsafe {
+        if rmm::mips::FORCE_UNCACHED {
+            // Write the data cache back (32 KiB covers every supported CPU),
+            // then make kseg0 uncached: Config.K0 = 2.
+            let mut addr = 0x8000_0000usize;
+            while addr < 0x8000_8000 {
+                core::arch::asm!("cache 1, 0({0})", in(reg) addr, options(nostack));
+                addr += 16;
+            }
+            cp0::write_config((cp0::read_config() & !7) | 2);
+        }
+
+        // The PROM console (the screen, or the serial port) and our own
+        // driver for Serial Port 1.
+        device::arcs::init();
+        device::serial::init();
+
+        info!("Redox OS starting...");
+        if rmm::mips::FORCE_UNCACHED {
+            info!("Indy: EXPERIMENT: kseg0 and all mappings uncached; this boot is slow");
+        }
+
+        // TLB cleared, exception vectors in kseg0, BEV off: from here a kernel
+        // fault prints its registers instead of vanishing into the PROM.
+        paging::init();
+        info!("Indy: BEV off, exceptions come to the kernel");
+
+        let ram = ram_bytes();
+        let kernel_base = consts::RAM_PHYS_BASE + consts::LOW_RESERVED_BYTES;
+        let kernel_end_virt = &raw const __end as usize;
+        let kernel_size = kernel_end_virt - crate::kernel_executable_offsets::KERNEL_OFFSET();
+        info!(
+            "Indy: {} MiB RAM at {:#x}, kernel {:#x}+{:#x}, bss {:#x}..{:#x}",
+            ram >> 20,
+            consts::RAM_PHYS_BASE,
+            kernel_base,
+            kernel_size,
+            &raw const __bss_start as usize,
+            &raw const __bss_end as usize,
+        );
+
+        // An initfs appended by `ecoff convert --append` sits on the first page
+        // boundary after the image: a header page then the payload.
+        let (bootstrap_base, bootstrap_size) = {
+            let header = ((kernel_end_virt + 4095) & !4095) as *const u8;
+            let magic = core::slice::from_raw_parts(header, 8);
+            if magic == b"REDOXIFS" {
+                let len = u32::from_be_bytes([
+                    header.add(8).read(),
+                    header.add(9).read(),
+                    header.add(10).read(),
+                    header.add(11).read(),
+                ]) as usize;
+                let base = header as usize + 4096 - PHYS_OFFSET;
+                (base, (len + 4095) & !4095)
+            } else {
+                (0, 0)
+            }
+        };
+        info!("Indy: initfs {:#x}+{:#x}", bootstrap_base, bootstrap_size);
+
+        let areas = &mut *AREAS.get();
+        areas[0] = AreaEntry {
+            base: consts::RAM_PHYS_BASE as u64,
+            size: consts::LOW_RESERVED_BYTES as u64,
+            kind: BootloaderMemoryKind::Reserved,
+        };
+        let mut area_count = 1;
+        if device::arcs::present() {
+            // Take what the PROM calls free, and the image it loaded. Its own
+            // ranges stay out of the allocator so its console keeps working.
+            let floor = kernel_base as u64;
+            let ceiling = (consts::RAM_PHYS_BASE + ram) as u64;
+            let mut descriptor = device::arcs::memory_descriptor(None);
+            while let Some(d) = descriptor {
+                let start = (d.base_page as u64) << 12;
+                let end = start + ((d.page_count as u64) << 12);
+                info!("Indy: PROM memory type {} at {:#x}..{:#x}", d.kind, start, end);
+                let usable = matches!(
+                    d.kind,
+                    device::arcs::MEM_FREE
+                        | device::arcs::MEM_FREE_CONTIGUOUS
+                        | device::arcs::MEM_LOADED_PROGRAM
+                );
+                let (start, end) = (start.max(floor), end.min(ceiling));
+                if usable && start < end && area_count < MAX_AREAS {
+                    areas[area_count] = AreaEntry {
+                        base: start,
+                        size: end - start,
+                        kind: BootloaderMemoryKind::Free,
+                    };
+                    area_count += 1;
+                }
+                descriptor = device::arcs::memory_descriptor(Some(d));
+            }
+        } else {
+            areas[1] = AreaEntry {
+                base: kernel_base as u64,
+                size: (ram - consts::LOW_RESERVED_BYTES) as u64,
+                kind: BootloaderMemoryKind::Free,
+            };
+            area_count = 2;
+        }
+
+        let stack_base = STACK.get() as usize - PHYS_OFFSET;
+        let args = KernelArgs {
+            kernel_base: kernel_base as u64,
+            kernel_size: kernel_size as u64,
+            stack_base: stack_base as u64,
+            stack_size: STACK_SIZE as u64,
+            env_base: (ENV.as_ptr() as usize - PHYS_OFFSET) as u64,
+            env_size: ENV.len() as u64,
+            hwdesc_base: 0,
+            hwdesc_size: 0,
+            // Read directly, not through phys_to_virt: give the kseg0 address.
+            areas_base: AREAS.get() as usize as u64,
+            areas_size: (area_count * size_of::<AreaEntry>()) as u64,
+            bootstrap_base: bootstrap_base as u64,
+            bootstrap_size: bootstrap_size as u64,
+        };
+        let args = &args;
+
+        graphical_debug::init(args.env());
+        args.print();
+
+        // Initialize RMM
+        let mut bump_allocator = crate::startup::memory::init(args, None, None);
+        info!("Indy: frame allocator ready");
+
+        crate::memory::init_mm(&mut bump_allocator);
+
+        crate::arch::misc::init(crate::cpu_set::LogicalCpuId::new(0));
+        info!(
+            "Indy: percpu block at {:#x}",
+            crate::arch::misc::arch_percpu() as usize
+        );
+
+        // Setup kernel heap (TLB-mapped kseg2: the first refills happen here)
+        allocator::init();
+        info!("Indy: kernel heap mapped at {:#x}", crate::kernel_heap_offset());
+
+        // Activate memory logging
+        crate::log::init();
+
+        // Initialize devices
+        device::init();
+
+        // Initialize all of the non-core devices not otherwise needed to complete initialization
+        device::init_noncore();
+
+        // T5 accounting: what the machine gave and what boot took.
+        info!(
+            "Indy: ram {} KiB, low reserved {} KiB, kernel image {} KiB, free after boot {} KiB ({} frames)",
+            ram >> 10,
+            consts::LOW_RESERVED_BYTES >> 10,
+            kernel_size >> 10,
+            (crate::memory::free_frames() * crate::memory::PAGE_SIZE) >> 10,
+            crate::memory::free_frames(),
+        );
+
+        if args.bootstrap_size == 0 {
+            info!("Indy: no initfs in the image, stopping");
+            loop {
+                super::interrupt::disable();
+                super::interrupt::halt();
+            }
+        }
+
+        let bootstrap = args.bootstrap();
+
+        crate::startup::kmain(
+            bootstrap,
+            Kstack::new().expect("failed to allocate stack"),
+        );
+    }
+}
+
+const PHYS_OFFSET: usize = <crate::arch::CurrentRmmArch as rmm::Arch>::PHYS_OFFSET;
diff --git a/src/arch/mips64/stop.rs b/src/arch/mips64/stop.rs
new file mode 100644
index 00000000..49d7eee0
--- /dev/null
+++ b/src/arch/mips64/stop.rs
@@ -0,0 +1,47 @@
+use crate::sync::CleanLockToken;
+
+/// Reset the machine through the memory controller: CPUCTRL0 bit 4 (SYSINIT)
+/// pulses the system reset line, so the PROM starts from a real reset with
+/// every device in its power-on state. Jumping to the PROM's entry instead
+/// left the real machine with a blank screen.
+pub unsafe fn kreset() -> ! {
+    println!("kreset");
+    unsafe { emergency_reset() }
+}
+
+pub unsafe fn emergency_reset() -> ! {
+    const MC_CPUCTRL0: *mut u32 = 0xBFA0_0004 as *mut u32;
+    const SYSINIT: u32 = 0x10;
+    unsafe {
+        super::interrupt::disable();
+        // First choice: the firmware's own Reboot. On the real machine both
+        // the SYSINIT reset and a jump to the PROM entry left the screen off
+        // and the PROM not running.
+        super::device::arcs::reboot();
+        MC_CPUCTRL0.write_volatile(MC_CPUCTRL0.read_volatile() | SYSINIT);
+        // The reset takes effect within a few bus cycles. If it does not,
+        // fall back to the PROM's entry with its own vectors selected.
+        for _ in 0..1_000_000 {
+            core::hint::spin_loop();
+        }
+        core::arch::asm!(
+            "li $8, 0x00400000", // Status: BEV only
+            "mtc0 $8, $12",
+            "li $8, 0xBFC00000",
+            "jr $8",
+            "nop",
+            options(noreturn, nostack)
+        );
+    }
+}
+
+pub unsafe fn kstop(_token: &mut CleanLockToken) -> ! {
+    // TODO: soft power off through the DS1386 / IOC2 power control register.
+    println!("kstop: halting");
+    loop {
+        unsafe {
+            super::interrupt::disable();
+            super::interrupt::halt();
+        }
+    }
+}
diff --git a/src/arch/mips64/time.rs b/src/arch/mips64/time.rs
new file mode 100644
index 00000000..58685027
--- /dev/null
+++ b/src/arch/mips64/time.rs
@@ -0,0 +1,61 @@
+//! Monotonic time from CP0 Count.
+//!
+//! Count runs at half the pipeline clock on the R4400. The emulator's default
+//! is 33 MHz; a real Indy must be calibrated against the IOC's 8254 at boot.
+//! Until that calibration exists the frequency is a constant.
+
+use core::sync::atomic::{AtomicU64, Ordering};
+
+use super::cp0;
+use crate::sync::CleanLockToken;
+
+/// CP0 Count increments per second.
+pub const COUNT_HZ: u64 = 33_000_000;
+
+/// Scheduler tick rate.
+pub const TICKS_PER_SECOND: u64 = 100;
+pub const COUNTS_PER_TICK: u32 = (COUNT_HZ / TICKS_PER_SECOND) as u32;
+
+/// Count value extended to 64 bits across wraps by the timer interrupt.
+static COUNT_HIGH: AtomicU64 = AtomicU64::new(0);
+static LAST_COUNT: AtomicU64 = AtomicU64::new(0);
+
+/// Called from the timer interrupt: track Count wrap-around and arm the next tick.
+pub fn tick() {
+    let now = cp0::read_count() as u64;
+    let last = LAST_COUNT.load(Ordering::Relaxed);
+    if now < last {
+        COUNT_HIGH.fetch_add(1 << 32, Ordering::Relaxed);
+    }
+    LAST_COUNT.store(now, Ordering::Relaxed);
+    unsafe {
+        cp0::write_compare(cp0::read_compare().wrapping_add(COUNTS_PER_TICK));
+    }
+}
+
+/// Start the Count/Compare timer and unmask IP7.
+pub unsafe fn init() {
+    unsafe {
+        cp0::write_count(0);
+        cp0::write_compare(COUNTS_PER_TICK);
+        LAST_COUNT.store(0, Ordering::Relaxed);
+        cp0::write_status(cp0::read_status() | cp0::status::IM7);
+    }
+}
+
+fn count64() -> u64 {
+    let now = cp0::read_count() as u64;
+    let mut high = COUNT_HIGH.load(Ordering::Relaxed);
+    if now < LAST_COUNT.load(Ordering::Relaxed) {
+        high += 1 << 32;
+    }
+    high | now
+}
+
+pub fn monotonic_absolute(_token: &mut CleanLockToken) -> u128 {
+    count64() as u128 * 1_000_000_000u128 / COUNT_HZ as u128
+}
+
+pub fn monotonic_resolution() -> u128 {
+    1_000_000_000u128 / COUNT_HZ as u128
+}
