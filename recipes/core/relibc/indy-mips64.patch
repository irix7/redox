+pub unsafe fn arch_pre(stack: &mut SigStack, area: &mut SigArea) -> PosixStackt {
+    // SP and PC cannot be restored in one instruction. A signal that lands
+    // inside one of the trampoline's two exits finds them half done; finish
+    // the exit here, on the interrupted context, so that returning from this
+    // signal goes straight to where that exit was heading. `int_regs[n - 1]`
+    // is `$n`: 12 is `$13`, 26 is `$27`, 28 is `$sp`.
+    let pc = stack.regs.pc as usize;
+    if pc == __relibc_internal_sigentry_crit_first as usize {
+        // Redo `ld $sp, 288($sp)`, then the jump.
+        let frame = stack.regs.int_regs[28] as usize as *const u64;
+        stack.regs.int_regs[28] = unsafe { frame.byte_add(SP_SLOT).read() };
+        stack.regs.pc = stack.regs.int_regs[26];
+    } else if pc == __relibc_internal_sigentry_crit_second as usize
+        || pc == __relibc_internal_sigentry_crit_fifth as usize
+    {
+        stack.regs.pc = stack.regs.int_regs[26];
+    } else if pc == __relibc_internal_sigentry_crit_third as usize {
+        stack.regs.int_regs[12] = area.spur_t1;
+        stack.regs.int_regs[26] = area.tmp_ip;
+        stack.regs.pc = area.tmp_ip;
+    } else if pc == __relibc_internal_sigentry_crit_fourth as usize {
+        stack.regs.int_regs[26] = area.tmp_ip;
+        stack.regs.pc = area.tmp_ip;
+    }
+    get_sigaltstack(area, stack.regs.int_regs[28] as usize).into()
+}
