 #![no_std]
+#![cfg_attr(target_arch = "mips64", feature(asm_experimental_arch))]
 #![allow(internal_features)]
 #![deny(unsafe_op_in_unsafe_fn)]
 
@@ -84,6 +85,24 @@ impl<Os> GenericTcb<Os> {
