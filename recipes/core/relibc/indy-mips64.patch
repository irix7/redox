+    ctl.control_flags.store(
+        ctl.control_flags.load(Ordering::Relaxed) | syscall::flag::INHIBIT_DELIVERY.bits(),
+        Ordering::Release,
+    );
+    ctl.saved_archdep_reg.set(0);
+    let ip_location = &raw const ctl.saved_ip as usize;
+
+    unsafe {
+        // $ra cannot be named as an operand: keep it on the stack around the call.
+        core::arch::asm!("
+                .set noreorder
+                addiu   $sp, $sp, -16
+                sw      $31, 0($sp)
+                bal     2f
+                nop
+                b       3f
+                nop
+            2:
+                sw      $31, 0({ip})
+                la      $25, __relibc_internal_sigentry
+                jr      $25
+                nop
+            3:
+                lw      $31, 0($sp)
+                addiu   $sp, $sp, 16
+                .set reorder
+            ",
+            ip = in(reg) ip_location, out("$25") _);
+    }
