+/// OS and architecture specific code to activate TLS - Redox mips64 n32
+///
+/// MIPS TLS variant I: the thread pointer is `tls_start + 0x7000`, and the
+/// linker biases `%tprel` relocations by -0x7000. The word just below the TLS
+/// block holds the TCB address, which `GenericTcb::arch_read` loads from
+/// `-0x7004($28)`.
+#[allow(unsafe_op_in_unsafe_fn)]
+#[cfg(target_arch = "mips64")]
+pub unsafe fn tcb_activate(_tcb: &RtTcb, tls_end: usize, tls_len: usize) {
+    let tls_start = tls_end - tls_len;
+    let abi_ptr = tls_start - 4;
+    core::ptr::write(abi_ptr as *mut u32, tls_end as u32);
+    core::arch::asm!(
+        "move $28, {}",
+        in(reg) tls_start + 0x7000
+    );
+    TLS_ACTIVATED.store(true, core::sync::atomic::Ordering::Relaxed);
+}
+
 /// Initialize redox-rt in situations where relibc is not used
 #[allow(unsafe_op_in_unsafe_fn)]
 #[cfg(not(feature = "proc"))]
@@ -182,11 +202,21 @@ pub unsafe fn initialize_freestanding(this_thr_fd: FdGuardUpper) -> &'static FdG
     // Make sure to use ptr::write to prevent dropping the existing FdGuard
     page.os_specific.thr_fd.get().write(Some(this_thr_fd));
 
-    #[cfg(not(any(target_arch = "aarch64", target_arch = "riscv64")))]
