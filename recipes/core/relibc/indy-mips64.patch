diff --git a/generic-rt/src/lib.rs b/generic-rt/src/lib.rs
index 226c366..738cd2b 100644
--- a/generic-rt/src/lib.rs
+++ b/generic-rt/src/lib.rs
@@ -1,4 +1,5 @@
 #![no_std]
+#![cfg_attr(target_arch = "mips64", feature(asm_experimental_arch))]
 #![allow(internal_features)]
 #![deny(unsafe_op_in_unsafe_fn)]
 
@@ -84,6 +85,24 @@ impl<Os> GenericTcb<Os> {
         value
     }
 
+    /// Architecture specific code to read a usize from the TCB - mips64 n32.
+    /// `$gp` is the MIPS thread pointer (`tls_start + 0x7000`); the TCB
+    /// address sits in the word below the TLS block. Pointers are 32 bits.
+    #[expect(unsafe_op_in_unsafe_fn)]
+    #[inline(always)]
+    #[cfg(target_arch = "mips64")]
+    unsafe fn arch_read(offset: usize) -> usize {
+        let value;
+        asm!(
+            "lw {value}, -28676($28)", // TCB address at tls_start - 4
+            "addu {value}, {value}, {offset}",
+            "lw {value}, 0({value})",
+            value = out(reg) value,
+            offset = in(reg) offset,
+        );
+        value
+    }
+
     pub unsafe fn current_ptr() -> Option<*mut Self> {
         let tcb_ptr = unsafe { Self::arch_read(offset_of!(Self, tcb_ptr)) as *mut Self };
         let tcb_len = unsafe { Self::arch_read(offset_of!(Self, tcb_len)) };
diff --git a/redox-rt/src/arch/mips64.rs b/redox-rt/src/arch/mips64.rs
new file mode 100644
index 0000000..f82aa25
--- /dev/null
+++ b/redox-rt/src/arch/mips64.rs
@@ -0,0 +1,638 @@
+//! MIPS n32 (SGI Indy). Registers are 64 bits wide, pointers 32.
+//!
+//! Thread pointer: `$gp` (`$28`) is the MIPS thread pointer
+//! (`tls_start + 0x7000`, variant I); the word below the TLS block holds the
+//! TCB address (see `generic_rt::GenericTcb::arch_read`). Compiled code is
+//! static with no GOT, so `$gp` is otherwise unused. The kernel emulates
+//! `rdhwr $rt, $29` with this register for compiled thread-local accesses.
+//!
+//! The signal trampoline keeps the TCB pointer in `$27` (k1) and makes its
+//! last jump through it. No compiled code uses k1, and the Indy kernel
+//! preserves it across exceptions for this purpose (k0 stays kernel scratch).
+//! The kernel's saved "archdep" register is not used: it is a `usize`, half
+//! the width of an n32 register.
+
+use core::cell::SyncUnsafeCell;
+
+use crate::{
+    Tcb,
+    proc::{FdGuard, FdGuardUpper, ForkArgs, fork_inner},
+    signal::{PosixStackt, RtSigarea, SigStack, get_sigaltstack, inner_c},
+};
+use core::{mem::offset_of, ptr::NonNull, sync::atomic::Ordering};
+use redox_protocols::protocol::{ProcCall, RtSigInfo};
+use syscall::{data::*, error::*};
+
+use super::ForkScratchpad;
+
+/// User mappings end at 0x7fff_0000 (the kernel's USER_END_OFFSET); the kernel's metadata pages sit just
+/// below that, and the initial stack grows down from below them.
+pub const STACK_TOP: usize = 0x7fff_0000 - syscall::KERNEL_METADATA_SIZE;
+pub const STACK_SIZE: usize = 1024 * 1024;
+
+#[derive(Debug, Default)]
+#[repr(C)]
+pub struct SigArea {
+    pub tmp_sp: u64,
+    pub tmp_t1: u64,
+    pub tmp_t2: u64,
+    pub tmp_t3: u64,
+    pub tmp_t4: u64,
+    pub tmp_a0: u64,
+    pub tmp_a1: u64,
+    pub tmp_a2: u64,
+    pub tmp_a3: u64,
+    pub tmp_a4: u64,
+    pub tmp_a7: u64,
+    pub tmp_t5: u64,
+    pub tmp_t6: u64,
+    /// `$13` for the spurious-signal exit; only that path writes it.
+    pub spur_t1: u64,
+
+    pub pctl: usize, // TODO: remove
+    pub tmp_ip: u64,
+    pub tmp_rt_inf: RtSigInfo,
+    pub tmp_id_inf: u64,
+    pub altstack_top: usize,
+    pub altstack_bottom: usize,
+    pub disable_signals_depth: u64,
+    pub last_sig_was_restart: bool,
+    pub last_sigstack: Option<NonNull<SigStack>>,
+}
+
+/// `$1`..`$31` then PC, HI and LO.
+#[repr(C)]
+#[derive(Debug, Default)]
+pub struct ArchIntRegs {
+    pub int_regs: [u64; 31],
+    pub pc: u64,
+    pub hi: u64,
+    pub lo: u64,
+}
+
+/// Deactive TLS, used before exec() on Redox to not trick target executable into thinking TLS
+/// is already initialized as if it was a thread.
+pub unsafe fn deactivate_tcb(open_via_dup: &FdGuardUpper) -> Result<()> {
+    let mut env = syscall::EnvRegisters::default();
+
+    let file = open_via_dup.dup_into_upper(b"regs/env")?;
+
+    env.tp = 0;
+
+    file.write(&env)?;
+    crate::TLS_ACTIVATED.store(false, core::sync::atomic::Ordering::Relaxed);
+    Ok(())
+}
+
+unsafe extern "C" fn fork_impl(args: &ForkArgs, initial_rsp: *mut usize) -> usize {
+    Error::mux(fork_inner(initial_rsp, args))
+}
+
+unsafe extern "C" fn child_hook(scratchpad: &ForkScratchpad) {
+    let _ = crate::sys::close(scratchpad.cur_filetable_fd);
+    unsafe {
+        crate::child_hook_common(crate::ChildHookCommonArgs {
+            new_thr_fd: FdGuard::new(scratchpad.new_thr_fd),
+            new_proc_fd: if scratchpad.new_proc_fd == usize::MAX {
+                None
+            } else {
+                Some(FdGuard::new(scratchpad.new_proc_fd))
+            },
+            new_filetable_fd: FdGuard::new(scratchpad.new_filetable_fd)
+                .to_upper()
+                .unwrap(),
+        })
+    };
+}
+
+// Callee-saved registers: s0..s7 ($16..$23), gp ($28), fp ($30), ra ($31).
+// The FPU is disabled (soft float), so no float state is saved.
+asmfunction!(__relibc_internal_fork_wrapper (usize) -> usize: ["
+    .set noreorder
+    addiu   $sp, $sp, -96
+    sd      $16, 0($sp)
+    sd      $17, 8($sp)
+    sd      $18, 16($sp)
+    sd      $19, 24($sp)
+    sd      $20, 32($sp)
+    sd      $21, 40($sp)
+    sd      $22, 48($sp)
+    sd      $23, 56($sp)
+    sd      $28, 64($sp)
+    sd      $30, 72($sp)
+    sd      $31, 80($sp)
+
+    // $a0 is forwarded from this function; $a1 is the saved-register block.
+    move    $5, $sp
+    la      $25, {fork_impl}
+    jalr    $25
+    nop
+
+    ld      $16, 0($sp)
+    ld      $17, 8($sp)
+    ld      $18, 16($sp)
+    ld      $19, 24($sp)
+    ld      $20, 32($sp)
+    ld      $21, 40($sp)
+    ld      $22, 48($sp)
+    ld      $23, 56($sp)
+    ld      $28, 64($sp)
+    ld      $30, 72($sp)
+    ld      $31, 80($sp)
+
+    jr      $31
+    addiu   $sp, $sp, 96
+    .set reorder
+"] <= [fork_impl = sym fork_impl]);
+
+asmfunction!(__relibc_internal_fork_ret: ["
+    .set noreorder
+    // The scratchpad arrives in $a1 (the kernel's arg1); child_hook takes it in $a0.
+    move    $4, $5
+    la      $25, {child_hook}
+    jalr    $25
+    nop
+
+    move    $2, $zero
+
+    ld      $16, 0($sp)
+    ld      $17, 8($sp)
+    ld      $18, 16($sp)
+    ld      $19, 24($sp)
+    ld      $20, 32($sp)
+    ld      $21, 40($sp)
+    ld      $22, 48($sp)
+    ld      $23, 56($sp)
+    ld      $28, 64($sp)
+    ld      $30, 72($sp)
+    ld      $31, 80($sp)
+
+    jr      $31
+    addiu   $sp, $sp, 96
+    .set reorder
+"] <= [child_hook = sym child_hook]);
+
+// The frame: 336 bytes, 16-byte aligned. The SigStack starts 8 bytes above
+// `$sp`; `regs` is 56 bytes into it, so register `$n` is at 64 + 8 * (n - 1),
+// then PC, HI and LO.
+const _: () = {
+    assert!(offset_of!(SigStack, regs) == 56);
+    assert!(offset_of!(SigStack, sig_num) == 48);
+    assert!(8 + size_of::<SigStack>() <= 336);
+    assert!(offset_of!(ArchIntRegs, pc) == 248);
+};
+
+asmfunction!(__relibc_internal_sigentry: ["
+    .set noreorder
+    .set noat
+    lw      $27, -28676($28)            // TCB
+    sd      $sp, {sa_tmp_sp}($27)
+    sd      $13, {sa_tmp_t1}($27)
+    sd      $14, {sa_tmp_t2}($27)
+    sd      $15, {sa_tmp_t3}($27)
+    sd      $24, {sa_tmp_t4}($27)
+    sd      $25, {sa_tmp_t5}($27)
+    sd      $11, {sa_tmp_t6}($27)
+    lw      $24, {sa_pctl}($27)
+
+    // Select a signal: the lowest pending and allowed one.
+99:
+    ld      $13, {sc_word0}($27)
+    dsrl32  $14, $13, 0                 // allowed, low word
+    and     $13, $13, $14
+    beqz    $13, 3f
+    nop
+    move    $15, $zero                  // thread signal in the first word
+2:  andi    $25, $13, 1
+    bnez    $25, 10f
+    nop
+    addiu   $15, $15, 1
+    b       2b
+    dsrl    $13, $13, 1
+
+    // No thread signal there: the process-wide word. This is a race with
+    // the other threads; whoever clears the pending bit has the signal.
+3:  ld      $13, {pctl_pending}($24)
+    dsll32  $13, $13, 0
+    dsrl32  $13, $13, 0
+    and     $13, $13, $14
+    beqz    $13, 4f
+    nop
+    li      $15, -1
+2:  andi    $25, $13, 1
+    addiu   $15, $15, 1
+    beqz    $25, 2b
+    dsrl    $13, $13, 1
+    sll     $13, $15, 3                 // * size_of SenderInfo
+    addu    $13, $13, $24
+    ld      $13, {pctl_sender_infos}($13)
+    sd      $13, {sa_tmp_id_inf}($27)
+    li      $13, 1
+    dsllv   $13, $13, $15
+5:  lld     $14, {pctl_pending}($24)
+    and     $25, $14, $13
+    beqz    $25, 4f                     // another thread took it
+    nop
+    xor     $25, $14, $13
+    scd     $25, {pctl_pending}($24)
+    beqz    $25, 5b
+    nop
+    b       9f
+    nop
+
+    // The second word, thread and process together: POSIX wants the lowest
+    // realtime signal first.
+4:  ld      $13, {sc_word1}($27)
+    ld      $14, {pctl_pending}($24)
+    dsrl32  $14, $14, 0
+    or      $25, $13, $14
+    dsrl32  $14, $13, 0
+    and     $25, $25, $14
+    beqz    $25, 7f
+    nop
+    li      $15, -1
+2:  andi    $14, $25, 1
+    addiu   $15, $15, 1
+    beqz    $14, 2b
+    dsrl    $25, $25, 1
+    li      $14, 1
+    dsllv   $14, $14, $15
+    and     $13, $13, $14
+    addiu   $15, $15, 32
+    bnez    $13, 10f                    // sent to this thread
+    nop
+
+    // A realtime signal for the process: dequeue it from the process
+    // manager. SYS_CALL(fd, payload, payload_len, metadata_len, metadata).
+    sd      $2, {sa_tmp_a7}($27)
+    sd      $4, {sa_tmp_a0}($27)
+    sd      $5, {sa_tmp_a1}($27)
+    sd      $6, {sa_tmp_a2}($27)
+    sd      $7, {sa_tmp_a3}($27)
+    sd      $8, {sa_tmp_a4}($27)
+    li      $2, {SYS_CALL}
+    la      $4, {proc_fd}
+    lw      $4, 0($4)
+    addiu   $5, $27, {sa_tmp_rt_inf}
+    addiu   $6, $15, -32
+    sw      $6, 0($5)
+    li      $6, {RTINF_SIZE}
+    li      $7, 1
+    la      $8, {proc_call}
+    syscall
+    move    $13, $2
+    ld      $2, {sa_tmp_a7}($27)
+    ld      $4, {sa_tmp_a0}($27)
+    ld      $5, {sa_tmp_a1}($27)
+    ld      $6, {sa_tmp_a2}($27)
+    ld      $7, {sa_tmp_a3}($27)
+    ld      $8, {sa_tmp_a4}($27)
+    bnez    $13, 99b                    // the only error is EAGAIN
+    nop
+    b       9f
+    nop
+
+    // A thread signal, number in $15: note the sender and clear the bit.
+10: srl     $13, $15, 5
+    bnez    $13, 2f
+    nop
+    sll     $14, $15, 3
+    addu    $14, $14, $27
+    ld      $14, {sc_sender_infos}($14)
+    sd      $14, {sa_tmp_id_inf}($27)
+2:  andi    $25, $15, 31
+    li      $14, 1
+    dsllv   $14, $14, $25
+    nor     $14, $14, $zero
+    sll     $13, $13, 3
+    addu    $13, $13, $27
+5:  lld     $25, {sc_word0}($13)
+    and     $25, $25, $14
+    scd     $25, {sc_word0}($13)
+    beqz    $25, 5b
+    nop
+    addiu   $15, $15, 64                // 64 and up: sent to the thread
+
+    // The signal is chosen. Move to the alternate stack if its action asks
+    // for it and this stack is not already inside it.
+9:  lw      $24, {sa_pctl}($27)
+    andi    $13, $15, 63
+    sll     $13, $13, 4                 // * size_of RawAction
+    addu    $13, $13, $24
+    ld      $13, {pctl_actions}($13)
+    dsll    $13, $13, 5                 // SA_ONSTACK (bit 58) to the sign bit
+    bgez    $13, 3f
+    nop
+    lw      $13, {sa_altstack_top}($27)
+    sltu    $14, $13, $sp
+    bnez    $14, 2f                     // above the alternate stack
+    nop
+    lw      $14, {sa_altstack_bottom}($27)
+    sltu    $14, $14, $sp
+    bnez    $14, 3f                     // inside it already
+    nop
+2:  move    $sp, $13
+3:
+    addiu   $sp, $sp, -336
+    li      $13, -16
+    and     $sp, $sp, $13
+
+    sd      $1, 64($sp)
+    sd      $2, 72($sp)
+    sd      $3, 80($sp)
+    sd      $4, 88($sp)
+    sd      $5, 96($sp)
+    sd      $6, 104($sp)
+    sd      $7, 112($sp)
+    sd      $8, 120($sp)
+    sd      $9, 128($sp)
+    sd      $10, 136($sp)
+    sd      $11, 144($sp)
+    sd      $12, 152($sp)
+    sd      $16, 184($sp)
+    sd      $17, 192($sp)
+    sd      $18, 200($sp)
+    sd      $19, 208($sp)
+    sd      $20, 216($sp)
+    sd      $21, 224($sp)
+    sd      $22, 232($sp)
+    sd      $23, 240($sp)
+    sd      $28, 280($sp)
+    sd      $30, 296($sp)
+    sd      $31, 304($sp)
+    ld      $13, {sa_tmp_t1}($27)
+    sd      $13, 160($sp)
+    ld      $13, {sa_tmp_t2}($27)
+    sd      $13, 168($sp)
+    ld      $13, {sa_tmp_t3}($27)
+    sd      $13, 176($sp)
+    ld      $13, {sa_tmp_t4}($27)
+    sd      $13, 248($sp)
+    ld      $13, {sa_tmp_t5}($27)
+    sd      $13, 256($sp)
+    ld      $13, {sa_tmp_t6}($27)
+    sd      $13, 144($sp)
+    sd      $zero, 264($sp)
+    sd      $zero, 272($sp)
+    ld      $13, {sa_tmp_sp}($27)
+    sd      $13, 288($sp)
+    lw      $13, {sc_saved_ip}($27)
+    sd      $13, 312($sp)
+    mfhi    $13
+    sd      $13, 320($sp)
+    mflo    $13
+    sd      $13, 328($sp)
+    sw      $15, 56($sp)                // SigStack::sig_num
+
+    addiu   $4, $sp, 8
+    la      $25, {inner}
+    jalr    $25
+    nop
+
+    ld      $13, 320($sp)
+    mthi    $13
+    ld      $13, 328($sp)
+    mtlo    $13
+    ld      $1, 64($sp)
+    ld      $2, 72($sp)
+    ld      $3, 80($sp)
+    ld      $4, 88($sp)
+    ld      $5, 96($sp)
+    ld      $6, 104($sp)
+    ld      $7, 112($sp)
+    ld      $8, 120($sp)
+    ld      $9, 128($sp)
+    ld      $10, 136($sp)
+    ld      $11, 144($sp)
+    ld      $12, 152($sp)
+    ld      $13, 160($sp)
+    ld      $14, 168($sp)
+    ld      $15, 176($sp)
+    ld      $16, 184($sp)
+    ld      $17, 192($sp)
+    ld      $18, 200($sp)
