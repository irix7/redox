@@ -0,0 +1,23 @@
+//! `sys/user.h` register sets for MIPS n32 (SGI Indy). Registers are 64 bits
+//! wide; the FPU is disabled, so the float set is a placeholder.
+
+use crate::platform::types::{c_double, c_uint, c_ulonglong};
+
+#[repr(C)]
+pub struct user_regs_struct {
+    /// `$1`..`$31`
+    pub regs: [c_ulonglong; 31],
+    pub pc: c_ulonglong,
+    pub hi: c_ulonglong,
+    pub lo: c_ulonglong,
+}
+
+#[repr(C)]
+pub struct user_fpregs_struct {
+    pub fpregs: [c_double; 32],
+    pub fcsr: c_uint,
+}
+
+pub type elf_greg_t = c_ulonglong;
+pub type elf_gregset_t = user_regs_struct;
+pub type elf_fpregset_t = user_fpregs_struct;
